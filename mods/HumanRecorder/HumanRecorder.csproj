<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HumanRecorder</AssemblyName>
    <Version>0.5.3</Version>
    <RootNamespace>Sts2HumanRecorder</RootNamespace>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(MSBuildThisFileDirectory)..\..\archives\sts2-v0.107.1-build-23811903\game\data_sts2_windows_x86_64</GameDataDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDataDir)\sts2.dll')" Text="v0.107.1 sts2.dll not found at $(GameDataDir)" />
  </Target>
  <Target Name="StageMod" AfterTargets="Build">
    <PropertyGroup><StageDir>$(MSBuildThisFileDirectory)..\..\dist\HumanRecorder</StageDir></PropertyGroup>
    <MakeDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb;$(MSBuildThisFileDirectory)HumanRecorder.json" DestinationFolder="$(StageDir)" />
  </Target>
</Project>
