{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sts2/combat-search-teacher-v0.schema.json",
  "title": "Spire Pilot 2 Combat Search Teacher Evidence V0",
  "type": "object",
  "required": [
    "schema_version",
    "search_version",
    "root_fingerprint",
    "root",
    "search_seed",
    "model_version",
    "requested_budget",
    "effective_budget",
    "root_determinization_count",
    "root_selection_rule",
    "policy_candidate_id",
    "search_candidate_id",
    "chosen_candidate_id",
    "policy_fallback",
    "actions"
  ],
  "properties": {
    "schema_version": {"const": "combat-search-teacher-0.1.0"},
    "search_version": {"const": "combat-search-0.2.0"},
    "root_fingerprint": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "root": {
      "type": "object",
      "required": ["observation_version", "action_version", "act", "floor", "observation", "candidates"]
    },
    "search_seed": {"type": "integer"},
    "model_version": {"type": "string"},
    "requested_budget": {"type": "integer", "minimum": 1},
    "effective_budget": {"type": "integer", "minimum": 1},
    "root_determinization_count": {"type": "integer", "minimum": 1},
    "root_selection_rule": {"type": "string"},
    "policy_candidate_id": {"type": "string"},
    "search_candidate_id": {"type": "string"},
    "chosen_candidate_id": {"type": "string"},
    "policy_fallback": {"type": "object"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate",
          "prior",
          "visits",
          "visit_policy_probability",
          "mean_value",
          "value_std",
          "lower_tail_cvar",
          "determinization_mean_value",
          "determinization_lower_tail_cvar",
          "death_probability",
          "end_hp_mean",
          "end_hp_std",
          "potion_spent_mean",
          "max_hp_delta_mean",
          "terminal_fraction",
          "mean_search_depth",
          "max_search_depth",
          "leaf_sources",
          "determinization_count",
          "determinization_values",
          "selection_score",
          "selection_eligible"
        ]
      }
    }
  },
  "additionalProperties": false
}
